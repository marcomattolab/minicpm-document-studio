# Backend HTTP server (kept on localhost by default)
APP_HOST=127.0.0.1
APP_PORT=8000

# MiniCPM-OCR SDK CLI and compatible inference server
MINICPM_OCR_COMMAND=minicpmvocr
MINICPM_OCR_SERVER_URL=http://127.0.0.1:18499
MINICPM_OCR_MODEL=minicpm-ocr
# Recognition backend: vllm | llamacpp | ollama | openai (empty defaults to vllm)
MINICPM_OCR_BACKEND=llamacpp
# Device used by the SDK for layout detection, not the inference server GPU selection
MINICPM_OCR_DEVICE=cpu

# Second pass: convert graphical flowcharts (image blocks) to Mermaid (1 = on, 0 = off)
MINICPM_DIAGRAM_MERMAID=1
# Timeout (seconds) for each diagram -> Mermaid request
MINICPM_DIAGRAM_TIMEOUT=120
# Optional: use a different endpoint/model for the diagram pass (defaults to the OCR server/model)
# MINICPM_DIAGRAM_SERVER_URL=http://127.0.0.1:18499
# MINICPM_DIAGRAM_MODEL=minicpm-ocr
