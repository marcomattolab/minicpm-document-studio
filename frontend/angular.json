{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "minicpm-document-studio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/minicpm-document-studio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "minicpm-document-studio:build:production"
            },
            "development": {
              "buildTarget": "minicpm-document-studio:build"
            },
            "defaultConfiguration": "development"
          },
          "options": {
            "buildTarget": "minicpm-document-studio:build",
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    }
  }
}